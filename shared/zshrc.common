# =============================================================================
# zshrc.common — the parts identical on every machine.
#
# Sourced from macos/.zshrc and linux/.zshrc, which each add their own PATH
# and tooling around it. Kept separate so a fix to the shell core does not
# have to be made twice.
#
# Order matters: plugins= must be set BEFORE oh-my-zsh.sh is sourced, or the
# list is ignored and no plugin loads.
# =============================================================================

export TERM=xterm-256color

# nano, not vi: git commit messages, crontab -e and the `config` alias all
# honour this.
export EDITOR=nano
export VISUAL=nano

# -U keeps these arrays de-duplicated for the whole session, so neither this
# file nor the per-OS one can stack a duplicate entry. Must come first.
typeset -U path PATH fpath FPATH

# ---- oh-my-zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# compinit stops to ask about group-writable completion directories. With no
# terminal to ask on it aborts with "not interactive and can't open terminal"
# and completion never loads. CI runners and containers hit this because their
# shared dirs are group-writable, and Ubuntu's /etc/zsh/zshrc can reach compinit
# before this file is read at all.
#
# ZSH_DISABLE_COMPFIX only covers oh-my-zsh's own call, so it is not enough on
# its own: compaudit is stubbed to report nothing insecure, which leaves every
# caller -- ours, oh-my-zsh's and the system's -- with nothing to prompt about.
ZSH_DISABLE_COMPFIX=true
compaudit() { : }

# Bundled plugins need no install; the three custom ones are cloned into
# ~/.oh-my-zsh/custom/plugins by the setup script.
plugins=(
  git
  z                              # bundled: jump to frecent dirs
  extract                        # bundled: `x file.whatever` unpacks anything
  command-not-found
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting        # must be last — it wraps the others
)

export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
else
  # Fresh machine: no framework yet. A bare prompt is fine; erroring is not.
  # -u accepts insecure directories instead of prompting about them.
  autoload -Uz compinit && compinit -u -d "${ZSH_COMPDUMP:-$HOME/.zcompdump}"
  PS1='%n@%m %1~ %# '
fi

# ---- history ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # one history across concurrent shells
setopt HIST_IGNORE_ALL_DUPS   # a repeated command replaces the older entry
setopt HIST_IGNORE_SPACE      # leading space keeps a command out of history
setopt HIST_VERIFY            # expand !! for review instead of running it
setopt EXTENDED_HISTORY       # record timestamps

setopt INTERACTIVE_COMMENTS   # allow # comments when typing interactively

# ---- node (nvm) --------------------------------------------------------------
# node, npm and npx are ordinary binaries in the version directory, so .zshenv
# puts them on PATH and nothing here needs to wrap them. Only `nvm` itself is
# a shell function (it edits PATH in the live shell), and sourcing nvm.sh to
# get it costs ~0.9s — far too much to pay on every prompt.
#
# So `nvm` alone is lazy. It unsets itself FIRST, so if nvm.sh ever fails to
# source the name falls through to PATH instead of calling itself again. An
# earlier version wrapped node/npm/npx the same way without the self-unset:
# when the helper went missing, Homebrew's command_not_found_handler
# re-invoked the wrapper and the shell spun until "maximum nested function
# level reached; increase FUNCNEST?". Agent shells hit that constantly.
export NVM_DIR="$HOME/.nvm"

if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm() {
    unset -f nvm 2>/dev/null
    . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
    nvm "$@"
  }

  # Auto-switch on cd into a directory with .nvmrc. Only pays the nvm.sh cost
  # in projects that actually pin a version.
  _nvm_auto() {
    [ -f .nvmrc ] || return 0
    nvm use --silent >/dev/null 2>&1
  }
  autoload -Uz add-zsh-hook && add-zsh-hook chpwd _nvm_auto
  _nvm_auto        # honour .nvmrc if the shell starts inside a project
fi

# ---- shell integrations -----------------------------------------------------
# Guarded so an absent tool does not error on every new shell.
# The redirect belongs INSIDE the substitution: `source <(cmd) 2>/dev/null`
# silences source, not cmd, so an old fzf still prints "unknown option: --zsh"
# to the terminal. --zsh arrived in fzf 0.48; Debian and Ubuntu ship older.
(( $+commands[fzf] )) && source <(fzf --zsh 2>/dev/null)

