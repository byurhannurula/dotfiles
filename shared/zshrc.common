# =============================================================================
# zshrc.common — the parts identical on every machine.
#
# Sourced from macos/.zshrc and linux/.zshrc, which each add their own PATH
# and tooling around it. Kept separate so a fix to the shell core does not
# have to be made twice.
#
# Order matters: plugins= must be set BEFORE oh-my-zsh.sh is sourced, or the
# list is ignored and no plugin loads.
# =============================================================================

export TERM=xterm-256color

# nano, not vi: git commit messages, crontab -e and the `config` alias all
# honour this.
export EDITOR=nano
export VISUAL=nano

# -U keeps these arrays de-duplicated for the whole session, so neither this
# file nor the per-OS one can stack a duplicate entry. Must come first.
typeset -U path PATH fpath FPATH

# ---- oh-my-zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Bundled plugins need no install; the three custom ones are cloned into
# ~/.oh-my-zsh/custom/plugins by the setup script.
plugins=(
  git
  z                              # bundled: jump to frecent dirs
  extract                        # bundled: `x file.whatever` unpacks anything
  command-not-found
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting        # must be last — it wraps the others
)

export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
else
  # Fresh machine: no framework yet. A bare prompt is fine; erroring is not.
  autoload -Uz compinit && compinit -u
  PS1='%n@%m %1~ %# '
fi

# ---- history ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # one history across concurrent shells
setopt HIST_IGNORE_ALL_DUPS   # a repeated command replaces the older entry
setopt HIST_IGNORE_SPACE      # leading space keeps a command out of history
setopt HIST_VERIFY            # expand !! for review instead of running it
setopt EXTENDED_HISTORY       # record timestamps

setopt INTERACTIVE_COMMENTS   # allow # comments when typing interactively

# ---- node (nvm, lazy) --------------------------------------------------------
# Sourcing nvm.sh eagerly costs ~200ms on every shell. Instead, define stubs
# that load nvm on first use, then hand off to the real command. The shell
# starts fast and nvm still works the first time you type it.
#
# .nvmrc is honoured: the chpwd hook below runs `nvm use` on entering a
# directory that has one, which is the behaviour the eager version gave.
export NVM_DIR="$HOME/.nvm"

_nvm_load() {
  unset -f nvm node npm npx 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}
if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm()  { _nvm_load; nvm "$@"; }
  node() { _nvm_load; node "$@"; }
  npm()  { _nvm_load; npm "$@"; }
  npx()  { _nvm_load; npx "$@"; }

  # Auto-switch on cd into a directory with .nvmrc
  _nvm_auto() {
    if [ -f .nvmrc ]; then
      _nvm_load 2>/dev/null
      # --silent suppresses the success line but not the "Found .nvmrc" notice
      nvm use --silent >/dev/null 2>&1
    fi
  }
  autoload -Uz add-zsh-hook && add-zsh-hook chpwd _nvm_auto
  _nvm_auto        # honour .nvmrc if the shell starts inside a project
fi

# ---- shell integrations -----------------------------------------------------
# Guarded so an absent tool does not error on every new shell.
(( $+commands[fzf] )) && source <(fzf --zsh) 2>/dev/null

