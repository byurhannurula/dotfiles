{
  // EDITOR
  "editor.fontFamily": "Menlo, Victor Mono, monospace",
  "editor.fontLigatures": false,
  "editor.lineHeight": 20,
  "editor.fontSize": 13,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 80,
  "editor.glyphMargin": false,
  "editor.tabCompletion": "on",
  "editor.minimap.enabled": false,
  "explorer.openEditors.visible": 1,
  "workbench.tree.indent": 16,
  "editor.foldingStrategy": "indentation",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.suggest.showStatusBar": true,

  // TERMINAL
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": "100",
  "terminal.integrated.fontFamily": "Menlo, monospace",
  // "terminal.integrated.shell.osx": "/bin/zsh",
  "terminal.integrated.cursorBlinking": true,

  // FILES
  "files.autoSave": "onFocusChange",
  "files.defaultLanguage": "html",
  "files.associations": {
    "*.html": "html",
    "*.css": "tailwindcss",
    "*.sass": "tailwindcss",
    "*.scss": "tailwindcss",
  },
  "editor.rulers": [80, 100, 120],
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "css.validate": false, // Disable css built-in lint
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "nunjucks": "html",
  },
  "files.exclude": {
    "**/.cache": true,
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.next": true,
    "**/.svn": true,
    "**/bower_components": true,
    "**/node_modules": true
  },
  "editor.quickSuggestions": {
    "strings": true,
  },

  // ESLINT/PRETTIER
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "todohighlight.isEnable": true,
  "explorer.compactFolders": false,
  "workbench.tree.renderIndentGuides": "none",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.colorDecorators": false,
  "colorize.hide_current_line_decorations": false,
  "workbench.sideBar.location": "right",
  "[handlebars]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "breadcrumbs.enabled": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.activityBar.location": "top",
  "eslint.debug": true,
  "workbench.iconTheme": "file-icons",
  "workbench.tree.enableStickyScroll": false,
  "editor.stickyScroll.enabled": false,
  "extensions.ignoreRecommendations": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "git.openRepositoryInParentFolders": "never",
  "todohighlight.keywords": ["TBD", "TBD:", "DISCUSS", "DISCUSS:"],
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.colorTheme": "Visual Studio Dark",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "terminal.integrated.initialHint": false,
  "workbench.browser.openLocalhostLinks": false,
  "workbench.editorAssociations": {
    "*.drawio": "default"
  },
  "hediet.vscode-drawio.resizeImages": null,
