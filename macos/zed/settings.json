// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "toolbar": {
    "agent_review": true
  },
  "agent": {
    "limit_content_width": true,
    "default_width": 630.0,
    "flexible": true,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark Official Icons)"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "terminal": {
    "font_size": 13.0,
    "font_family": "Menlo",
    "font_fallbacks": [
      "monospace"
    ],
    "blinking": "on"
  },
  "project_panel": {
    "auto_fold_dirs": false
  },
  "status_bar": {
    "experimental.show": false
  },
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "never"
  },
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["Menlo"],
  "buffer_font_family": "Menlo",
  "ui_font_size": 16,
  "buffer_font_size": 13.5,
  "file_types": {
    "html": [
      "*.html"
    ],
    "tailwindcss": [
      "*.css",
      "*.sass",
      "*.scss"
    ]
  },
  "wrap_guides": [
    80,
    100,
    120
  ],
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "opus",
          "sonnet"
        ]
      },
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",

  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "VSCode Dark Modern",
  },
  "gutter":{ "min_line_number_digits": 0 }
}
