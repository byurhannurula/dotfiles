# =============================================================================
# Brewfile.personal — apps for a personal Mac only.
#
# Apply on top of the base:  brew bundle --file=macos/Brewfile.personal
# install.sh asks about this file after the base Brewfile, default no.
# =============================================================================

tap "abue-ammar/tinycast"

# ---- comms ------------------------------------------------------------------
cask "discord"
cask "telegram"
cask "viber"

# ---- media ------------------------------------------------------------------
cask "iptvnator"
cask "calibre"
cask "transmission"
cask "abue-ammar/tinycast/tinycast", trusted: true
brew "yt-dlp"

# ---- 3d printing and imaging ------------------------------------------------
cask "bambu-studio"
cask "orcaslicer"
cask "openscad@snapshot"
cask "raspberry-pi-imager"
cask "balenaetcher"

# ---- homelab and hardware ---------------------------------------------------
brew "hidapi"
brew "minicom"
brew "nut"
brew "smartmontools"
brew "telnet"
cask "home-assistant"
cask "anydesk"
cask "firebird-emu"
# cask "silicon-labs-vcp-driver"   # vendor URL returns 403 (2026-10)

